# Nach .env kopieren und anpassen.
MQTT_HOST=192.168.1.10          # Mosquitto; muss vom Container aus erreichbar sein
MQTT_PORT=1883
MQTT_USER=                      # leer lassen, wenn der Broker anonyme Clients erlaubt
MQTT_PASSWORD=
ARCHIVE_KEEP=30
# Mehrere Roboter: Topic-Wurzel (Firmware-Präfix = <TOPIC_ROOT>/<gerät>), Standardgerät für alte Daten,
# Anzeigenamen in der Geräteauswahl der Karte.
TOPIC_ROOT=tesvor
DEFAULT_DEVICE=x500
DEVICE_NAMES=x500=Tesvor X500 Pro
TZ=Europe/Berlin
# Ordner, den Home Assistant unter /local/tesvor-map/ ausliefert (www/tesvor-map im HA-Config-Verzeichnis).
HA_WWW_TESVOR=/pfad/zu/homeassistant/config/www/tesvor-map
