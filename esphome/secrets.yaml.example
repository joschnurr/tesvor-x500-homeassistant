# Nach secrets.yaml kopieren und ausfüllen (liegt im ESPHome-Konfigverzeichnis neben den YAML-Dateien).
wifi_ssid: "MEIN-WLAN"            # 2,4 GHz
wifi_password: "wlan-passwort"
ap_password: "fallback-hotspot"   # Notfall-Hotspot "Tesvor X500 Fallback", wenn das WLAN fehlt
mqtt_broker: 192.168.1.10         # IP des MQTT-Brokers (Mosquitto), Port 1883
tesvor_api_key: "32-Byte-Base64-Schluessel"   # erzeugen: openssl rand -base64 32 — gilt für API und OTA
